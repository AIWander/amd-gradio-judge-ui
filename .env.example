MCPCONFIG_URL=          # e.g. http://<droplet-ip>:8003/v1
VLLM_BASE_URL=          # e.g. http://<droplet-ip>:8001  (vLLM 120b instance — used for /metrics)
VLLM_BASE_URL_8002=     # gpt-oss-20b
MOCK_MODE=true          # default true
GITHUB_ORG=AIWander
GITHUB_TOKEN=           # optional, raises GitHub API rate limit
